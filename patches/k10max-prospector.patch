+# K10 Max ANSI RGB — Prospector status keymap
+#
+# Everything the stock `keychron` keymap enables, plus the status module.
+# VIA_ENABLE keeps remapping working exactly as shipped.
+
+VIA_ENABLE = yes
+
+# Real inputs for the status frame.
+WPM_ENABLE = yes
+CAPS_WORD_ENABLE = yes
+
+include keyboards/keychron/common/prospector/prospector.mk
