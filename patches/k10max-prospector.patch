+};
+// clang-format on
+
+/* ------------------------------------------------------ Prospector hooks -- */
+
+void keyboard_post_init_user(void) {
+    prospector_status_init();
+}
+
+void housekeeping_task_user(void) {
+    prospector_status_task();
+}
+
+bool process_record_user(uint16_t keycode, keyrecord_t *record) {
+    if (record->event.pressed) {
+        /* Feeds the idle/active scheduling: 1 Hz while typing, 30 s when idle. */
+        prospector_status_note_activity();
+    }
+    return true;
+}
