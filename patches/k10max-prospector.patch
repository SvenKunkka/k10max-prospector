+/* Copyright 2026 Keychron
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * K10 Max ANSI RGB — stock Keychron keymap + Prospector status module.
+ *
+ * This keymap is byte-for-byte the official `keychron` keymap (same four
+ * layers, same multimedia/Bluetooth/2.4 GHz/RGB/remap keycodes) with the
+ * Prospector status collector wired into the QMK task hooks. Choosing this
+ * keymap therefore costs nothing in normal keyboard function.
+ *
+ * Read docs/BLOCKER.md before expecting the Prospector screen to react: the
+ * K10 Max's BLE advertisement is produced inside the LKBT51 module, which this
+ * firmware cannot command, so the encoded frame has no radio to leave through.
+ */
+
+#include QMK_KEYBOARD_H
+#include "keychron_common.h"
+#include "prospector_qmk.h"
+
+enum layers {
+    MAC_BASE,
+    MAC_FN,
+    WIN_BASE,
+    WIN_FN,
+};
+
+#define FN_MAC MO(MAC_FN)
+#define FN_WIN MO(WIN_FN)
+
+// clang-format off
